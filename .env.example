# Which AI provider to use: mock | gemini | deepseek | claude | openai
AI_PROVIDER=mock

# Only needed for the matching provider. Put real values in .env.local (gitignored).
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Neshan web map key (public by design, restrict it to your domains in the Neshan panel).
# Without it the map falls back to OpenStreetMap tiles.
NEXT_PUBLIC_NESHAN_MAP_KEY=

# Neshan *service* key (server-only, NOT the web map key) for the Search API: live nearby places
# («مزیت‌های محله»). Create an "API key" of type service in the Neshan panel with Search enabled.
# Without it the neighborhood advantages use the baked OpenStreetMap places (src/data/pois.json).
NESHAN_API_KEY=
